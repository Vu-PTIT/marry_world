# Development runs with one authoritative Python process and temporary memory.
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Set for Redis coordination. Distributed zones require Redis.
REDIS_URL=
REDIS_PREFIX=wedding-world
# 0 = in-process simulation; 1 = six separate zone processes
WORLD_ZONE_WORKERS=0
# Base64 of 32 random bytes; set a stable private signing key in deployment.
COMPLETION_PRIVATE_KEY=
# Comma-separated trusted reverse proxies are configured in the Uvicorn command.
MAX_GUESTS=500
